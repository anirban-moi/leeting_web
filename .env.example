# ==============================================================================
# LEETING WEB: ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLERK AUTHENTICATION (https://dashboard.clerk.com)
# ------------------------------------------------------------------------------
# Create an application in Clerk -> copy the keys from "API Keys":
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Standard Clerk URL routing paths:
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & STORAGE (https://supabase.com)
# ------------------------------------------------------------------------------
# Copy Project URL & Publishable Anon Key from Supabase -> Project Settings -> API:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
